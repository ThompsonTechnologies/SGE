## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build Folders
bin/
obj/

# Visual Studio temp files, build results, and
# user-specific files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Visual Studio Code workspace
.vscode/

# Visual Studio cache/options directory
.vs/

# Rider
.idea/

# NuGet
*.nupkg
# The packages folder can be ignored because of PackageReference
packages/

# NuGet v3's project.json files
project.lock.json

# Resharper
_ReSharper*/
*.ReSharper*/
ReSharperReport.*

# dotCover
.dotCover

# NCrunch
.ncrunch*

# MSTest test results
TestResult*/
TestResults/

# Build results
*.dll
*.exe
*.app
*.lib
*.so
*.dylib
*.pdb
*.mdb

# Database files
*.mdf
*.ldf

# Visual Studio publish folder
publish/

# Azure publish settings
*.Publish.xml

# SQL Server files
*.bak

# Logs
*.log

# JetBrains Rider
/.idea/

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Dependency directories
node_modules/
codex/

# OS files
.DS_Store
Thumbs.db
